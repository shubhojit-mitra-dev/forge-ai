# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://forge-ai.shubhojitmitra.com

# ── LLM Providers (Free Tier Keys) ────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
NVIDIA_API_KEY=nvapi-...
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...

# ── LiteLLM Gateway ───────────────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-forge-local-master

# ── Supabase Cloud ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=forge-documents

# ── ForgeAI Pipeline Guardrails ───────────────────────────────────────────────
FORGE_MAX_ITERATIONS=3
FORGE_MAX_LLM_CALLS_PER_RUN=120
FORGE_MAX_TOKENS_PER_RUN=150000
FORGE_EARLY_STOP_MIN_DELTA=0.02
FORGE_CACHE_TTL_SECONDS=3600

